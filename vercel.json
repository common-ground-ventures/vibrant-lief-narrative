{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "anewlief.com"
        }
      ],
      "destination": "https://www.anewlief.com/:path*",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/team",
      "permanent": true
    },
    {
      "source": "/liefblocks",
      "destination": "/sabs",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/v1",
      "destination": "/index.html"
    }
  ],
  "installCommand": "echo prerendered-static",
  "buildCommand": "echo prerendered-static",
  "outputDirectory": "dist",
  "framework": null
}
